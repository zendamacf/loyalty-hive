{
  "name": "@loyalty-hive",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "prepare": "husky",
    "lint": "bun run --workspaces lint",
    "lint:api": "bun run --filter @loyalty-hive/api lint",
    "lint:app": "bun run --filter @loyalty-hive/app lint",
    "typecheck": "bun run --workspaces typecheck",
    "typecheck:api": "bun run --filter @loyalty-hive/api typecheck",
    "typecheck:app": "bun run --filter @loyalty-hive/app typecheck",
    "test": "bun run --workspaces test",
    "test:api": "bun run --filter @loyalty-hive/api test",
    "test:app": "bun run --filter @loyalty-hive/app test",
    "check": "bun run lint && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@changesets/cli": "^3.0.3"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  },
  "overrides": {
    "react-native-worklets": "0.13.0",
    "@expo/log-box": "58.0.13",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo-application": "~58.1.2",
    "expo-constants": "~58.0.13",
    "expo-device": "~58.0.5",
    "expo-localization": "~58.0.5"
  }
}
