# Production Docker Compose (.env next to docker-compose.yml on the VPS)
# Copy to .env in this directory: cp .env.compose.example .env
DB_PASSWORD=
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=7d
# Admin panel session secret. Must be different from JWT_ACCESS_SECRET. Admin login is off when unset.
ADMIN_JWT_SECRET=
ADMIN_JWT_TTL=8h
FILE_STORAGE_URL=https://loyaltyhive.kalopsia.dev/
SENTRY_DSN=
APP_PORT=3000
APP_IMAGE=ghcr.io/zendamacf/loyalty-hive-api:latest
# Number of reverse proxies in front of the API that add X-Forwarded-For.
# Traefik only = 1. nginx in front of Traefik = 2. Too high lets clients fake
# their IP for rate limits. Too low makes all clients share one rate limit.
TRUST_PROXY_HOPS=1
