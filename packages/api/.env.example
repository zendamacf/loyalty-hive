# Local development (bun dev / db:migrate / start)
# Copy to .env in this directory: cp .env.example .env
LIB_VERSION=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/loyalty_hive
JWT_ACCESS_SECRET=
# Access token lifetime (seconds or duration: 15m, 24h, 7d). No refresh token — users sign in again after expiry.
JWT_ACCESS_TTL=7d
# Admin panel session secret. Must be different from JWT_ACCESS_SECRET. Admin login is off when unset.
ADMIN_JWT_SECRET=
# Admin session lifetime (seconds or duration: 15m, 8h, 1d)
ADMIN_JWT_TTL=8h
# Admin panel build served at /admin (default ../admin/dist). Run `bun run build:admin` from the repo root first.
# ADMIN_DIST_DIR=../admin/dist
FILE_STORAGE_URL=http://localhost:3000/
SENTRY_DSN=
PORT=3000

# Auth rate limits (in-memory, per API process; tune for production)
# Reverse proxies in front of the API that add X-Forwarded-For (0 = none, use the
# connection address). Only the last N entries are trusted, and only from a private address.
TRUST_PROXY_HOPS=0
RATE_LIMIT_AUTH_LOGIN_IP_MAX=10
RATE_LIMIT_AUTH_LOGIN_IP_WINDOW_MS=60000
RATE_LIMIT_AUTH_LOGIN_EMAIL_MAX=5
RATE_LIMIT_AUTH_LOGIN_EMAIL_WINDOW_MS=60000
RATE_LIMIT_AUTH_SIGNUP_IP_MAX=5
RATE_LIMIT_AUTH_SIGNUP_IP_WINDOW_MS=60000
RATE_LIMIT_AUTH_DELETE_ACCOUNT_MAX=5
RATE_LIMIT_AUTH_DELETE_ACCOUNT_WINDOW_MS=60000
RATE_LIMIT_AUTH_FORGOT_PASSWORD_IP_MAX=5
RATE_LIMIT_AUTH_FORGOT_PASSWORD_IP_WINDOW_MS=60000
RATE_LIMIT_AUTH_FORGOT_PASSWORD_EMAIL_MAX=3
RATE_LIMIT_AUTH_FORGOT_PASSWORD_EMAIL_WINDOW_MS=60000
RATE_LIMIT_AUTH_RESET_PASSWORD_IP_MAX=10
RATE_LIMIT_AUTH_RESET_PASSWORD_IP_WINDOW_MS=60000
RATE_LIMIT_ADMIN_LOGIN_IP_MAX=5
RATE_LIMIT_ADMIN_LOGIN_IP_WINDOW_MS=60000
RATE_LIMIT_ADMIN_LOGIN_EMAIL_MAX=5
RATE_LIMIT_ADMIN_LOGIN_EMAIL_WINDOW_MS=60000

# Transactional email (Resend). When unset, Emails are logged to the console.
RESEND_API_KEY=
EMAIL_FROM=Your Name <sender@domain.com>
