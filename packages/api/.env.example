# Local development (bun dev / db:migrate / start)
# Copy to .env in this directory: cp .env.example .env
LIB_VERSION=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/loyalty_hive
JWT_ACCESS_SECRET=
FILE_STORAGE_URL=http://localhost:3000/
SENTRY_DSN=
PORT=3000

# Auth rate limits (in-memory, per API process; tune for production)
RATE_LIMIT_AUTH_LOGIN_IP_MAX=10
RATE_LIMIT_AUTH_LOGIN_IP_WINDOW_MS=60000
RATE_LIMIT_AUTH_LOGIN_EMAIL_MAX=5
RATE_LIMIT_AUTH_LOGIN_EMAIL_WINDOW_MS=60000
RATE_LIMIT_AUTH_SIGNUP_IP_MAX=5
RATE_LIMIT_AUTH_SIGNUP_IP_WINDOW_MS=60000
