{
  "name": "@loyalty-hive/app",
  "version": "1.1.2",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:android": "expo start --android",
    "android:prebuild": "expo prebuild --platform android --clean",
    "android:run": "expo run:android",
    "eas:init": "eas init",
    "build:android:development": "eas build --platform android --profile development",
    "build:android:preview": "eas build --platform android --profile preview",
    "build:android:production": "eas build --platform android --profile production",
    "web": "expo start --web",
    "test": "bun test --preload ./test/setup.ts ./src ./test/routes",
    "lint": "biome check src",
    "lint:fix": "biome check src --write",
    "typecheck": "tsc --noEmit",
    "api:generate": "openapi-ts && bun run api:generate:hotfix",
    "api:generate:hotfix": "sed -i '1s;^;// @ts-expect-error Generated runtimeConfigPath import uses a .ts extension\\n;' src/lib/api-client/gen/client.gen.ts",
    "postversion": "react-native-version --never-amend"
  },
  "dependencies": {
    "@hey-api/client-fetch": "^0.13.1",
    "@hey-api/openapi-ts": "^0.99.0",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-navigation/native": "^7.3.14",
    "@sentry/react-native": "8.20.0",
    "@tanstack/react-query": "^5.101.4",
    "babel-preset-expo": "~57.0.4",
    "dotenv": "^17.4.2",
    "expo": "~57.0.8",
    "expo-brightness": "~57.0.1",
    "expo-camera": "^57.0.3",
    "expo-clipboard": "~57.0.1",
    "expo-dev-client": "~57.0.9",
    "expo-localization": "~57.0.1",
    "expo-router": "~57.0.8",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "hono": "^4.12.32",
    "i18next": "^26.3.6",
    "lucide-react-native": "^1.27.0",
    "react": "19.2.8",
    "react-i18next": "^17.0.11",
    "react-native": "0.86.0",
    "react-native-actions-sheet": "^10.1.2",
    "react-native-barcode-svg": "^0.0.15",
    "react-native-gesture-handler": "~3.1.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.5.3",
    "react-native-safe-area-context": "~5.8.0",
    "react-native-svg": "15.15.5",
    "react-native-version": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@testing-library/react-native": "^14.0.1",
    "@types/react": "~19.2.10",
    "bun-types": "^1.3.13",
    "eas-cli": "^21.3.0",
    "react-native-dotenv": "^3.4.12",
    "react-native-svg-transformer": "1.5.3",
    "test-renderer": "^1.2.0",
    "typescript": "~7.0.2"
  }
}
