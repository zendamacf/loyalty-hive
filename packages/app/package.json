{
  "name": "@loyalty-hive/app",
  "version": "1.2.1",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:android": "expo start --android",
    "android:prebuild": "expo prebuild --platform android --clean",
    "android:run": "expo run:android",
    "eas:init": "bun x eas-cli init",
    "build:android:development": "bun x eas-cli build --platform android --profile development",
    "build:android:preview": "bun x eas-cli build --platform android --profile preview",
    "build:android:production": "bun x eas-cli build --platform android --profile production",
    "web": "expo start --web",
    "test": "bun test --preload ./test/setup.ts ./src ./test/routes",
    "lint": "biome check src",
    "lint:fix": "biome check src --write",
    "typecheck": "tsc --noEmit",
    "bundle:android:ci": "bun x expo export:embed --eager --platform android --dev false",
    "doctor": "bun scripts/check-native-deps.ts && bun scripts/check-rn-runtime.ts && bun x eas-cli --version && bun x expo install --check && bun x expo-doctor",
    "api:generate": "openapi-ts",
    "postversion": "react-native-version --never-amend"
  },
  "dependencies": {
    "@bitte-kaufen/expo-umami": "github:zendamacf/expo-umami#v0.3.0-analytics-rc2",
    "@hey-api/client-fetch": "^0.13.1",
    "@hey-api/openapi-ts": "^0.99.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.3.17",
    "@sentry/react-native": "8.28.0",
    "@tanstack/react-query": "^5.104.0",
    "babel-preset-expo": "~58.0.0",
    "dotenv": "^18.0.4",
    "expo": "~58.0.0",
    "expo-brightness": "~58.0.2",
    "expo-camera": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.15",
    "expo-linking": "~58.0.14",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "hono": "^4.13.9",
    "i18next": "^26.4.0",
    "lucide-react-native": "^1.48.0",
    "react": "19.3.0",
    "react-i18next": "^17.0.12",
    "react-native": "0.88.0",
    "react-native-actions-sheet": "^10.1.2",
    "react-native-barcode-svg": "^0.0.15",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-qrcode-svg": "^6.3.26",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.0",
    "react-native-svg": "15.16.0",
    "react-native-version": "^4.0.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@testing-library/react-native": "^14.0.1",
    "@types/react": "~19.3.0",
    "bun-types": "^1.4.0",
    "react-native-dotenv": "^5.0.0",
    "react-native-svg-transformer": "1.5.3",
    "test-renderer": "^1.2.0",
    "typescript": "~7.0.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "@sentry/react-native",
        "expo",
        "expo-brightness",
        "expo-camera",
        "expo-clipboard",
        "expo-dev-client",
        "expo-localization",
        "expo-router",
        "expo-secure-store",
        "expo-splash-screen",
        "react",
        "react-native",
        "react-native-safe-area-context",
        "react-native-svg",
        "typescript"
      ]
    }
  }
}
