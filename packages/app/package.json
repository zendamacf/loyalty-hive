{
  "name": "@loyalty-hive/app",
  "version": "1.1.7",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:android": "expo start --android",
    "android:prebuild": "expo prebuild --platform android --clean",
    "android:run": "expo run:android",
    "eas:init": "bun x eas-cli init",
    "build:android:development": "bun x eas-cli build --platform android --profile development",
    "build:android:preview": "bun x eas-cli build --platform android --profile preview",
    "build:android:production": "bun x eas-cli build --platform android --profile production",
    "web": "expo start --web",
    "test": "bun test --preload ./test/setup.ts ./src ./test/routes",
    "lint": "biome check src",
    "lint:fix": "biome check src --write",
    "typecheck": "tsc --noEmit",
    "doctor": "bun scripts/check-native-deps.ts && bun x expo-doctor",
    "api:generate": "openapi-ts && bun run api:generate:hotfix",
    "api:generate:hotfix": "sed -i '1s;^;// @ts-expect-error Generated runtimeConfigPath import uses a .ts extension\\n;' src/lib/api-client/gen/client.gen.ts",
    "postversion": "react-native-version --never-amend"
  },
  "dependencies": {
    "@hey-api/client-fetch": "^0.13.1",
    "@hey-api/openapi-ts": "^0.99.0",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-navigation/native": "^7.3.16",
    "@sentry/react-native": "8.23.0",
    "@tanstack/react-query": "^5.101.4",
    "babel-preset-expo": "~57.0.7",
    "dotenv": "^17.4.2",
    "expo": "~57.0.14",
    "expo-brightness": "~57.0.1",
    "expo-camera": "^57.0.3",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.13",
    "expo-linking": "^57.0.10",
    "expo-localization": "~57.0.1",
    "expo-router": "~57.0.14",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "hono": "^4.13.3",
    "i18next": "^26.3.6",
    "lucide-react-native": "^1.33.0",
    "react": "19.2.8",
    "react-i18next": "^17.0.11",
    "react-native": "0.87.0",
    "react-native-actions-sheet": "^10.1.2",
    "react-native-barcode-svg": "^0.0.15",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-svg": "15.15.5",
    "react-native-version": "^4.0.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@testing-library/react-native": "^14.0.1",
    "@types/react": "~19.2.18",
    "bun-types": "^1.3.13",
    "react-native-dotenv": "^4.1.1",
    "react-native-svg-transformer": "1.5.3",
    "test-renderer": "^1.2.0",
    "typescript": "~7.0.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "@react-native-async-storage/async-storage",
        "@sentry/react-native",
        "expo",
        "expo-brightness",
        "expo-camera",
        "expo-clipboard",
        "expo-dev-client",
        "expo-localization",
        "expo-router",
        "expo-secure-store",
        "expo-splash-screen",
        "react",
        "react-native",
        "react-native-safe-area-context",
        "react-native-svg",
        "typescript"
      ]
    }
  }
}
